# LLMs for the "Refine" feature. Any OpenAI-compatible chat API works.
# Copy this file to .env, fill in what you use, then restart the server.
#
# LLM_PROVIDERS lists the providers to enable (comma-separated). Each provider <NAME> needs:
#   LLM_<NAME>_BASE_URL   OpenAI-compatible base URL
#   LLM_<NAME>_MODELS     comma-separated model names; each one appears in the LLM dropdown
#   LLM_<NAME>_API_KEY    optional for local servers
#   LLM_<NAME>_REFERENCE_MAX_CHARS  optional, max characters per reference page for this provider
# The first model of the first provider is the default.
# Model names change often; list a provider's models with GET {BASE_URL}/models
LLM_PROVIDERS=gemini

# --- Google AI Studio (Gemini, has a free tier) ---
# Key: https://aistudio.google.com/apikey
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_GEMINI_API_KEY=
LLM_GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# Gemini has a very long context: send whole transcripts and let the model find the scene.
LLM_GEMINI_REFERENCE_MAX_CHARS=300000

# --- Groq (free tier) --- add "groq" to LLM_PROVIDERS to enable
# Key: https://console.groq.com/keys
# LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
# LLM_GROQ_API_KEY=your-key
# LLM_GROQ_MODELS=llama-3.3-70b-versatile

# --- OpenRouter (models ending in :free) --- add "openrouter" to LLM_PROVIDERS
# Key: https://openrouter.ai/keys  Free models: https://openrouter.ai/models?q=free
# LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_OPENROUTER_API_KEY=your-key
# LLM_OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free

# --- Local Ollama (no key needed) --- add "ollama" to LLM_PROVIDERS
# Install https://ollama.com, then: ollama pull qwen2.5:7b
# LLM_OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_OLLAMA_MODELS=qwen2.5:7b

# --- Local LM Studio (no key needed) --- add "lmstudio" to LLM_PROVIDERS
# LLM_LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LLM_LMSTUDIO_MODELS=the-model-name-shown-in-lm-studio

# Optional: the model used for "Translate only" (<provider>/<model>, one of the models above). Translating one
# line doesn't need the best model, so pick a cheap one; empty = the model chosen in the dropdown.
LLM_TRANSLATE_MODEL=gemini/gemini-3.5-flash-lite

# Request timeout in milliseconds (local models can be slow).
LLM_TIMEOUT_MS=120000

# Default max characters sent from each reference URL (LLM_<NAME>_REFERENCE_MAX_CHARS overrides it per provider).
# Pages longer than the limit are cut around the part matching the scene.
# Lower it (e.g. 6000) for small local models with short context windows.
REFERENCE_MAX_CHARS=20000
